async function loadAIKnowledge(){if(KAVIRO_V4.knowledgeCache)return KAVIRO_V4.knowledgeCache;const [k,f,s,p,c]=await Promise.all([sb.from('ai_knowledge').select('question,answer,keywords').eq('active',true).limit(300),sb.from('faq').select('*').eq('active',true).limit(100),sb.from('services').select('title,name,description,price,delivery_days').eq('active',true).limit(100),sb.from('pricing').select('title,price,description,features').limit(100),sb.from('site_settings').select('data').eq('key','main').maybeSingle()]);KAVIRO_V4.knowledgeCache={knowledge:k.data||[],faq:f.data||[],services:s.data||[],pricing:p.data||[],settings:c.data?.data||{}};return KAVIRO_V4.knowledgeCache}
function localAIAnswer(q,d){const t=q.toLowerCase();if(/سعر|أسعار|بكام|جنيه|تكلفة|price/.test(t)){const prices=d.pricing.map(x=>`${x.title}: ${x.price!=null?x.price+' جنيه':'حسب المشروع'}`).join('، ');return prices||'الأسعار بتتغير حسب الخدمات والباقات، وتقدر تشوف الأسعار الحالية في قسم الأسعار.'}if(/خدم|بتقدم|services/.test(t)){return d.services.map(x=>x.title||x.name).join('، ')||'الخدمات الحالية موجودة في قسم الخدمات بالموقع.'}if(/طلب|أطلب|مشروع|order/.test(t))return 'علشان تطلب مشروع، سجّل دخولك أو أنشئ حساب، وبعدها اضغط «ابدأ مشروعك» واملأ بيانات الطلب.';if(/مراجع|رأى|review|تقييم/.test(t))return 'تقدر تكتب مراجعة بعد تسجيل الدخول. المراجعة بتدخل للمراجعة الإدارية قبل ظهورها للعامة.';if(/حساب|دخول|تسجيل|كلمة السر/.test(t))return 'تقدر تسجّل حساب جديد، تدخل بحسابك، وتستعيد كلمة السر من شاشة تسجيل الدخول.';if(/متابع|طلباتي|حالة الطلب|status/.test(t))return currentUser?'افتح «حسابي» من الشريط العلوي علشان تشوف طلباتك وحالاتها.':'سجّل دخولك أولًا، وبعدها افتح «حسابي» لمتابعة طلباتك.';const hit=d.knowledge.find(x=>(String(x.question)+' '+String(x.keywords||'')).toLowerCase().split(/\s+/).some(w=>w.length>2&&t.includes(w)));if(hit)return hit.answer;const fq=d.faq.find(x=>t.includes(String(x.question||'').toLowerCase().slice(0,18)));if(fq)return fq.answer;return 'مش لاقي إجابة مؤكدة للسؤال ده حاليًا. سجّلت سؤالك لفريق KAVIRO علشان نضيف إجابته للمعرفة، وتقدر كمان تسألني بصياغة مختلفة.'}
async function askKaviroQuick(q){document.getElementById('aiInput').value=q;await sendKaviroAI()}
async function sendKaviroAI(){const input=document.getElementById('aiInput'),q=input.value.trim();if(!q)return;input.value='';aiSay(q,'user');const thinking=document.createElement('div');thinking.className='ai-msg bot';thinking.textContent='بفكر...';document.getElementById('aiBody').appendChild(thinking);try{const d=await loadAIKnowledge();let answer;if(KAVIRO_V4.aiEndpoint){const r=await fetch(KAVIRO_V4.aiEndpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:q,session_id:KAVIRO_V4.sessionId,user_id:currentUser?.id||null})});const j=await r.json();answer=j.answer||localAIAnswer(q,d)}else answer=localAIAnswer(q,d);thinking.textContent=answer;await sb.from('ai_questions').insert({user_id:currentUser?.id||null,session_id:KAVIRO_V4.sessionId,question:q,answer,source:KAVIRO_V4.aiEndpoint?'ai':'knowledge',status:/مش لاقي|غير متأكد|مش موجود/.test(answer)?'unanswered':'answered'});await sb.from('ai_messages').insert([{session_id:KAVIRO_V4.sessionId,user_id:currentUser?.id||null,role:'user',content:q},{session_id:KAVIRO_V4.sessionId,user_id:currentUser?.id||null,role:'assistant',content:answer}])}catch(e){thinking.textContent='حصل خطأ مؤقت. جرّب السؤال تاني، وسجّلنا المشكلة.';console.warn(e)}}
const _oldOpenModal=openModal;openModal=function(type){_oldOpenModal(type);if(type==='project')setTimeout(enhanceProjectForm,0)};
function enhanceProjectForm(){const f=document.querySelector('#modal form');if(!f||f.dataset.v4)return;f.dataset.v4='1';const wrap=document.createElement('div');wrap.className='row';wrap.innerHTML='<div class="field"><label>تاريخ التسليم المطلوب</label><input name="desired_delivery_date" type="date"></div><div class="field"><label>الأولوية</label><select name="priority"><option value="normal">عادية</option><option value="high">عالية</option><option value="urgent">عاجلة</option></select></div>';f.querySelector('button[type=submit]')?.parentNode.before(wrap);const file=document.createElement('div');file.className='field';file.innerHTML='<label>ملفات المشروع (اختياري)</label><input name="project_files" type="file" multiple>';f.querySelector('button[type=submit]')?.parentNode.before(file);f.addEventListener('submit',async ev=>{ev.preventDefault();await submitProjectV4(f)},{capture:true})}
async function submitProjectV4(f){if(!currentUser){openAuthGate();return}const fd=new FormData(f),name=String(fd.get('name')||'').trim(),phone=String(fd.get('phone')||'').trim(),service=String(fd.get('service')||'').trim(),project_name=String(fd.get('project_name')||'').trim(),description=String(fd.get('description')||'').trim(),budgetRaw=String(fd.get('budget')||'').trim(),budget=budgetRaw===''?null:Number(budgetRaw);if(budgetRaw!==''&&!Number.isFinite(budget)){showToast('اكتب ميزانية صحيحة');return}const orderNumber='KVR-'+Math.floor(100000+Math.random()*900000),serviceRow=publicServices.find(x=>String(x.title||x.name||'')===service);const payload={id:orderNumber,order_number:orderNumber,user_id:currentUser.id,client_name:name,client_email:currentUser.email,client_phone:phone||null,name,email:currentUser.email,phone:phone||null,service,service_id:serviceRow?.id||null,project_name:project_name||null,description,budget,status:'new',desired_delivery_date:fd.get('desired_delivery_date')||null,priority:fd.get('priority')||'normal'};const r=await sb.from('orders').insert(payload);if(r.error){showToast('تعذر إرسال الطلب: '+r.error.message);return}const files=[...(fd.getAll('project_files')||[])].filter(x=>x?.name);for(const file of files){const path=`orders/${orderNumber}/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g,'_')}`;const up=await sb.storage.from('portfolio').upload(path,file,{upsert:false});if(!up.error)await sb.from('order_files').insert({order_id:orderNumber,user_id:currentUser.id,file_name:file.name,storage_path:path,mime_type:file.type,size_bytes:file.size});}closeModal();f.reset();showToast('تم إرسال الطلب '+orderNumber+' ✅');openAccountCenter()}
function addAccountButton(){const actions=document.querySelector('.nav .actions');if(!actions||document.getElementById('accountCenterBtn'))return;const b=document.createElement('button');b.id='accountCenterBtn';b.className='btn';b.textContent='حسابي';b.onclick=openAccountCenter;actions.insertBefore(b,actions.firstChild)}
const _oldUpdateAccountUI=updateAccountUI;updateAccountUI=function(){_oldUpdateAccountUI();addAccountButton();const b=document.getElementById('accountCenterBtn');if(b)b.style.display=currentUser?'inline-flex':'none'};
</script>
<div id="accountCenter" class="account-center" aria-hidden="true"><div class="account-panel"><div class="account-head"><div><h2 style="margin:0">👤 حسابي</h2><div id="accountEmail" class="muted"></div></div><button class="btn" onclick="closeAccountCenter()">إغلاق</button></div><div class="account-grid"><div class="account-stat"><b id="acOrders">0</b><div class="muted">كل الطلبات</div></div><div class="account-stat"><b id="acActive">0</b><div class="muted">قيد التنفيذ</div></div><div class="account-stat"><b id="acDone">0</b><div class="muted">مكتملة</div></div><div class="account-stat"><b id="acUnread">0</b><div class="muted">إشعارات غير مقروءة</div></div></div><h3>📦 طلباتي</h3><div id="accountOrders"></div><h3>🔔 الإشعارات</h3><div id="accountNotifications"></div></div></div>
<div id="aiChat" class="ai-chat"><div class="ai-box"><div class="ai-head"><b>🤖 KAVIRO AI</b><button class="btn" onclick="toggleKaviroAI(false)">×</button></div><div id="aiBody" class="ai-body"><div class="ai-msg bot">أهلًا بك 👋 أنا مساعد KAVIRO. اسألني عن الخدمات، الأسعار، الطلبات، الحساب، المراجعات أو أي شيء متعلق بالموقع.</div></div><div class="quick-q"><button class="btn" onclick="askKaviroQuick('إيه الخدمات والأسعار؟')">الخدمات والأسعار</button><button class="btn" onclick="askKaviroQuick('إزاي أطلب مشروع؟')">إزاي أطلب؟</button><button class="btn" onclick="askKaviroQuick('إزاي أتابع طلبي؟')">متابعة الطلب</button></div><div class="ai-input"><input id="aiInput" placeholder="اكتب سؤالك..." onkeydown="if(event.key==='Enter')sendKaviroAI()"><button class="btn primary" onclick="sendKaviroAI()">إرسال</button></div></div></div><button class="ai-fab" onclick="toggleKaviroAI(true)">🤖 اسأل KAVIRO AI</button>


<style id="kaviro-pro-enhancements">
/* ===== PRELOADER ===== */
.preloader{position:fixed;inset:0;z-index:99999;background:#05060a;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;transition:opacity .6s ease,visibility .6s ease}
.preloader.hide{opacity:0;visibility:hidden;pointer-events:none}
.preloader img{width:110px;height:110px;border-radius:24px;box-shadow:0 0 60px #38bdf855,0 0 120px #38bdf833;animation:pulse 1.6s ease-in-out infinite}
.preloader .pl-bar{width:180px;height:3px;background:#ffffff14;border-radius:99px;overflow:hidden}
.preloader .pl-bar i{display:block;height:100%;width:40%;background:linear-gradient(90deg,#38bdf8,#b7ff4a);border-radius:99px;animation:plload 1.1s ease-in-out infinite}
@keyframes plload{0%{transform:translateX(120%)}100%{transform:translateX(-320%)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
/* ===== NAVBAR PRO ===== */
.nav{transition:height .3s ease,background .3s ease,box-shadow .3s ease}
.nav.scrolled{background:#05060af2;box-shadow:0 8px 40px #0009;border-bottom:1px solid #ffffff12}
.nav.scrolled .navin{height:64px}
.brand span{transition:.3s}
.brand:hover span{color:#38bdf8;text-shadow:0 0 18px #38bdf866}
.logo{border:1px solid #38bdf833;box-shadow:0 0 25px #38bdf833;transition:.35s}
.logo:hover{transform:rotate(-6deg) scale(1.08);box-shadow:0 0 45px #38bdf866}
.links a{position:relative;padding:6px 2px;transition:.25s}
.links a::after{content:"";position:absolute;bottom:0;right:50%;transform:translateX(50%);width:0;height:2px;background:linear-gradient(90deg,#38bdf8,#b7ff4a);border-radius:2px;transition:width .3s ease}
.links a:hover::after,.links a.active::after{width:100%}
.links a.active{color:#38bdf8}
/* ===== HAMBURGER (mobile menu) ===== */
.nav-burger{display:none;width:44px;height:44px;border:1px solid #ffffff22;background:#ffffff08;border-radius:12px;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer}
.nav-burger span{display:block;width:20px;height:2px;background:#fff;border-radius:2px;transition:.3s}
.nav-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-burger.open span:nth-child(2){opacity:0}
.nav-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mobile-menu{display:none;position:fixed;top:76px;right:0;left:0;z-index:49;background:#0a0d13f5;backdrop-filter:blur(20px);border-bottom:1px solid #ffffff12;padding:14px 22px;flex-direction:column;gap:2px;transform:translateY(-8px);opacity:0;pointer-events:none;transition:.3s ease}
.mobile-menu.open{transform:translateY(0);opacity:1;pointer-events:auto}
.mobile-menu a{padding:13px 6px;color:#d5d9e2;font-weight:600;border-bottom:1px solid #ffffff08;transition:.2s}
.mobile-menu a:hover{color:#38bdf8;padding-right:14px}
@media(max-width:850px){.nav-burger{display:flex}}
/* ===== SCROLL REVEAL ===== */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .8s ease,transform .8s cubic-bezier(.22,1,.36,1)}
.reveal.in{opacity:1;transform:none}
.reveal-d1{transition-delay:.12s}.reveal-d2{transition-delay:.24s}.reveal-d3{transition-delay:.36s}
/* ===== MARQUEE STRIP ===== */
.marquee-strip{overflow:hidden;border-top:1px solid #ffffff0d;border-bottom:1px solid #ffffff0d;background:linear-gradient(90deg,#38bdf808,#b7ff4a08);padding:14px 0;direction:ltr}
.marquee-inner{display:flex;gap:44px;width:max-content;animation:marquee 22s linear infinite;white-space:nowrap}
.marquee-inner span{font-family:'Space Grotesk',Cairo,sans-serif;font-weight:700;letter-spacing:2px;font-size:15px;color:#9aa0ad;display:flex;align-items:center;gap:44px}
.marquee-inner b{color:#38bdf8}
@keyframes marquee{to{transform:translateX(-50%)}}
/* ===== SCROLLBAR & SELECTION ===== */
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-track{background:#0a0d13}
::-webkit-scrollbar-thumb{background:linear-gradient(#38bdf8,#6d5dfc);border-radius:99px}
::selection{background:#38bdf8;color:#05060a}
/* ===== BACK TO TOP ===== */
.back-top{position:fixed;bottom:90px;left:20px;z-index:900;width:46px;height:46px;border-radius:14px;border:1px solid #ffffff22;background:#0e1420f0;color:#fff;font-size:20px;cursor:pointer;display:grid;place-items:center;opacity:0;pointer-events:none;transition:.3s;box-shadow:0 10px 30px #0008}
.back-top.show{opacity:1;pointer-events:auto}
.back-top:hover{background:#38bdf8;color:#05060a;transform:translateY(-4px)}
/* ===== CARD HOVER GLOW ===== */
.service,.portfolio,.card{transition:transform .35s ease,border-color .35s ease,box-shadow .35s ease}
.service:hover,.portfolio:hover,.card:hover{transform:translateY(-8px);border-color:#38bdf844;box-shadow:0 18px 50px #0009,0 0 30px #38bdf812}
/* ===== BUTTON SHIMMER ===== */
.btn.primary{position:relative;overflow:hidden}
.btn.primary::after{content:"";position:absolute;top:0;left:-80%;width:50%;height:100%;background:linear-gradient(105deg,transparent,#ffffff55,transparent);transform:skewX(-20deg);animation:shimmer 3.2s ease-in-out infinite}
@keyframes shimmer{0%{left:-80%}55%{left:130%}100%{left:130%}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
<script id="kaviro-pro-js">
/* Preloader */
const pl=document.createElement('div');pl.className='preloader';
pl.innerHTML='<img src="'+document.querySelector('.nav .logo img')?.src+'" alt="KAVIRO"><div class="pl-bar"><i></i></div>';
document.body.appendChild(pl);
window.addEventListener('load',()=>setTimeout(()=>pl.classList.add('hide'),500));
setTimeout(()=>pl.classList.add('hide'),3500);
/* Scrollspy + navbar state */
const navEl=document.querySelector('.nav');
const secs=['home','services','portfolio','about','pricing','reviews','contact'].map(id=>document.getElementById(id)).filter(Boolean);
const navLinks=[...document.querySelectorAll('.links a')];
function onScroll(){
  navEl.classList.toggle('scrolled',window.scrollY>40);
  const y=window.scrollY+140;
  let active=secs[0];
  secs.forEach(s=>{if(s.offsetTop<=y)active=s});
  navLinks.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+active?.id));
  document.getElementById('backTop')?.classList.toggle('show',window.scrollY>600);
}
window.addEventListener('scroll',onScroll,{passive:true});onScroll();
/* Mobile menu */
const burger=document.createElement('button');burger.className='nav-burger';burger.setAttribute('aria-label','القائمة');
burger.innerHTML='<span></span><span></span><span></span>';
const actions=document.querySelector('.nav .actions');actions&&actions.parentNode.insertBefore(burger,actions);
const mm=document.createElement('nav');mm.className='mobile-menu';
navLinks.forEach(a=>{const c=a.cloneNode(true);c.addEventListener('click',()=>{mm.classList.remove('open');burger.classList.remove('open')});mm.appendChild(c)});
document.body.appendChild(mm);
burger.addEventListener('click',()=>{burger.classList.toggle('open');mm.classList.toggle('open')});
/* Back to top */
const bt=document.createElement('button');bt.id='backTop';bt.className='back-top';bt.innerHTML='↑';bt.title='العودة للأعلى';
bt.onclick=()=>window.scrollTo({top:0,behavior:'smooth'});document.body.appendChild(bt);
/* Scroll reveal */
const revObs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');revObs.unobserve(e.target)}}),{threshold:.12});
function initReveal(){
  const targets=document.querySelectorAll('.service,.portfolio,.why .card,.stat,.cta,.section-head');
  targets.forEach((t,i)=>{if(t.classList.contains('reveal')||t.dataset.rev)return;t.dataset.rev='1';
    t.classList.add('reveal',['','reveal-d1','reveal-d2','reveal-d3'][i%4]);revObs.observe(t)});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(initReveal,700));else setTimeout(initReveal,700);
/* Marquee */
const mq=document.createElement('div');mq.className='marquee-strip';
const mqItems='<span><b>KAVIRO AI STUDIO</b> ✦ AI IMAGE CREATION ✦ <b>AI VIDEO</b> ✦ BRANDING ✦ <b>GRAPHIC DESIGN</b> ✦ SOCIAL MEDIA ✦ <b>CINEMATIC</b> ✦ </span>';
mq.innerHTML='<div class="marquee-inner">'+mqItems+mqItems+'</div>';
document.querySelector('.stats')?.after(mq);
</script>

